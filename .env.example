# 复制本文件为 .env 并填入真实值：  cp .env.example .env
# .env 已被 .gitignore 排除，永远不会进入仓库。

# ── 麦当劳 MCP ─────────────────────────────────────────────
# 获取方式：打开 https://open.mcd.cn/mcp → 手机号登录 → 控制台 → 激活 → 一键复制
MCD_MCP_TOKEN=

# MCP 接入地址（一般无需修改）
MCD_MCP_URL=https://mcp.mcd.cn
# 仅允许显式配置的本机回环 HTTP 代理；公网 MCP 地址必须使用 HTTPS。
MCD_MCP_ALLOW_INSECURE_LOOPBACK=false
# 支付链接域名白名单，逗号分隔；留空使用代码内置的麦当劳域名白名单。
# MCD_PAYMENT_HOSTS=pay.mcd.cn,mcd.cn

# ── 微信公众号 ─────────────────────────────────────────────
# 公众号后台「开发 → 基本配置 → 服务器配置」中的令牌，需与本文件保持一致
WECHAT_TOKEN=
# AppID 与 AppSecret，用于调用客服消息接口异步推送下单结果
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ── 服务 ──────────────────────────────────────────────────
PORT=8787
# 监听地址。默认 127.0.0.1（只听本机，配内网穿透用）；
# 正式部署在服务器/容器里时改 0.0.0.0，由 Nginx/Caddy 反代对外提供 HTTPS。
# ⚠️ 改成 0.0.0.0 后，网页模拟器与 /api/chat 会**自动关闭**（它们无需验签即可驱动下单链路）
HOST=127.0.0.1

# 明文模式(plain) / 兼容模式(mixed) / 安全模式(encrypt)。个人调试建议 plain
WECHAT_ENCRYPT_MODE=plain
# 非明文模式下必填的 43 位 EncodingAESKey（公众号后台点「随机生成」可得）
WECHAT_ENCODING_AES_KEY=

# 是否开放调试入口（/ 网页模拟器、/api/chat）。
# 不填 = 安全默认：仅当 HOST 是回环地址时开放；显式设 true 才强制开放。
# EXPOSE_MOCK=true

# ── 下单安全策略 ──────────────────────────────────────────
# create-order 会产生真实订单与支付链接，以下是防止误花真钱的五道闸。
# ⚠️ ORDER_REQUIRE_CONFIRM 仅在 Mock/演示模式生效；真实 MCP 模式下代码级强制开启

# 二次确认总开关
ORDER_REQUIRE_CONFIRM=true

# 1) 冷却：同一用户两次下单之间的最小间隔（毫秒）
ORDER_COOLDOWN_MS=60000

# 2) 确认令牌有效期（毫秒）——超时后预览卡片作废，必须重发指令
CONFIRM_TTL_MS=300000
# 同一用户最多同时挂着几张待确认预览
CONFIRM_MAX_PENDING=3
# 多实例部署时必配：否则各实例的令牌互不认（回落为随机进程密钥）
# CONFIRM_SECRET=

# 3) 次数限额
ORDER_MAX_PER_HOUR=3
ORDER_MAX_PER_DAY=8

# 4) 金额限额（单位为「分」——注意 query-meals 返回元、calculate-price 返回分）
ORDER_MAX_CENTS_PER_ORDER=20000
ORDER_MAX_CENTS_PER_DAY=50000

# 5) 超过这个金额（分）需要把「确认」再说一次，且不自动重试失败的 create-order
ORDER_STRONG_CONFIRM_ABOVE_CENTS=10000

# ── 持久化与入口防护 ─────────────────────────────────────
# 真实模式下用于跨重启/多进程原子 claim；多实例必须挂载同一持久卷。
ORDER_STATE_DB=.cache/order-state.sqlite
ORDER_PENDING_TIMEOUT_MS=300000
# Node 入口必须与 Caddy/Nginx 的 1 MiB 上限保持一致。
HTTP_MAX_BODY_BYTES=1048576
HTTP_REQUEST_TIMEOUT_MS=5000
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX=60
