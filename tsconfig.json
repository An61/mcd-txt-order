{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "$comment": "本项目运行时零依赖：直接由 Node 22.6+ 原生剥离类型执行（--experimental-strip-types），无需构建。此文件仅用于编辑器类型提示；若要跑 tsc，需额外安装 typescript 与 @types/node。"
}
